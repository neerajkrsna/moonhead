# Core Pressure, Memory & Scheduling
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_PSI=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y

# Security, Sandboxing & Zero-Copy I/O
# CONFIG_DEBUG_INFO_NONE is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_DYNAMIC_FTRACE_WITH_ARGS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_SECURITY=y
CONFIG_BPF_LSM=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_IO_URING=y
CONFIG_XDP_SOCKETS=y
CONFIG_FUSE_FS=y

# Immutable Rootfs & Direct VirtIO Boot (Zero Initramfs)
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_DM_VERITY=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Hardware QoS & Ring Acceleration (Architecture-dependent options auto-filtered)
CONFIG_X86_FRED=y
CONFIG_X86_CPU_RESCTRL=y
CONFIG_CGROUP_DMEM=y
CONFIG_ARM64_MTE=y

# Writable OverlayFS & Block Cgroup Accounting
CONFIG_OVERLAY_FS=y
CONFIG_BLK_CGROUP=y

# Standalone UEFI .img / .iso Boot Support
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# CD-ROM & USB Storage Drivers for Standalone .iso / .img Boot
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# VMware & VirtIO Network Drivers
CONFIG_VMXNET3=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_VIRTIO_NET=y

# VMware Hard Disk & Partition Support (.vmdk)
CONFIG_BLK_DEV_SD=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
